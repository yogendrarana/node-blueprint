<%_ if (database === "postgres") { _%>
import { type InferSelectModel, type InferInsertModel, relations } from "drizzle-orm";
import { pgTable, text, timestamp, varchar, uuid } from "drizzle-orm/pg-core";
import { Roles, type Role } from "../../../shared/constants/roles.js";

<%_ if (auth === "jwt") { _%>
import { tokenSchema } from "./token.schema.js";
<%_ } _%>

// schema definition
export const userSchema = pgTable("users",
    {
        id: uuid("id")
            .primaryKey()
            .notNull()
            .defaultRandom(),
        name: varchar("name", { length: 50 }),
        email: varchar("email", { length: 255 }).notNull().unique(),
        password: text("password").notNull(),
        role: varchar("role", { length: 20 }).$type<Role>().notNull().default(Roles.USER),
        createdAt: timestamp("created_at").notNull().defaultNow(),
        updatedAt: timestamp("updated_at").notNull().defaultNow()
    }
);

<%_ if (auth === "jwt") { _%>
// relations
export const userRelations = relations(userSchema, ({ many }) => ({
    tokens: many(tokenSchema)
}));
<%_ } _%>

// types
export type User = InferSelectModel<typeof userSchema>;
export type NewUser = InferInsertModel<typeof userSchema>;
<%_ } _%>
<%_ if (database === "mysql") { _%>
import { type InferSelectModel, type InferInsertModel, relations } from "drizzle-orm";
import { mysqlTable, text, timestamp, varchar, int } from "drizzle-orm/mysql-core";
import { Roles, type Role } from "../../../shared/constants/roles.js";

<%_ if (auth === "jwt") { _%>
import { tokenSchema } from "./token.schema.js";
<%_ } _%>

// schema definition
export const userSchema = mysqlTable("users", {
    id: int("id").primaryKey().autoincrement(),
    name: varchar("name", { length: 50 }),
    email: varchar("email", { length: 255 }).notNull().unique(),
    password: text("password").notNull(),
    role: varchar("role", { length: 20 }).$type<Role>().notNull().default(Roles.USER),
    createdAt: timestamp("created_at").notNull().defaultNow(),
    updatedAt: timestamp("updated_at").notNull().defaultNow()
});

<%_ if (auth === "jwt") { _%>
// relations
export const userRelations = relations(userSchema, ({ many }) => ({
    tokens: many(tokenSchema)
}));
<%_ } _%>

// types
export type User = InferSelectModel<typeof userSchema>;
export type NewUser = InferInsertModel<typeof userSchema>;
<%_ } _%>
