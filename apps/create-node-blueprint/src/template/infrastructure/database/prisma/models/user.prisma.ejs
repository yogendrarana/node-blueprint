model User {
    id        String   @id @default(uuid())
    name      String?  @db.VarChar(50)
    email     String   @unique @db.VarChar(255)
    password  String
    role      RoleEnum @default(user)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    <%_ if (auth === "jwt") { _%>

    tokens    Token[]
    <%_ } _%>

    @@map("users")
}
