import { eq } from "drizzle-orm";
import db from "../../infrastructure/database/index.js";
import { userSchema, type NewUser } from "../../infrastructure/database/schema/user.schema.js";

export const userRepo = {
    async findUsers() {
        return db
            .select({
                id: userSchema.id,
                name: userSchema.name,
                email: userSchema.email,
                role: userSchema.role,
                createdAt: userSchema.createdAt,
                updatedAt: userSchema.updatedAt
            })
            .from(userSchema);
    },

    async findUserById(id: string) {
        const [user] = await db
            .select({
                id: userSchema.id,
                name: userSchema.name,
                email: userSchema.email,
                role: userSchema.role,
                createdAt: userSchema.createdAt,
                updatedAt: userSchema.updatedAt
            })
            .from(userSchema)
            .where(eq(userSchema.id, <%_ if (database === 'mysql') { _%>Number(id)<%_ } else { _%>id<%_ } _%>));
        return user || null;
    },

    async findUserByEmail(email: string) {
        const [user] = await db
            .select()
            .from(userSchema)
            .where(eq(userSchema.email, email));
        return user || null;
    },

    async createUser(data: NewUser) {
        <%_ if (database === 'postgres') { _%>
        const [newUser] = await db.insert(userSchema).values(data).returning();
        return newUser;
        <%_ } else { _%>
        const [result] = await db.insert(userSchema).values(data);
        return result;
        <%_ } _%>
    },

    async deleteUser(id: string) {
        return db
            .delete(userSchema)
            .where(eq(userSchema.id, <%_ if (database === 'mysql') { _%>Number(id)<%_ } else { _%>id<%_ } _%>));
    }
};
